# ============================================================
# Portfólio — variáveis de ambiente
# ============================================================

# URL do site (usada em Open Graph, canonical, sitemap)
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Ative para consumir dados via HTTP (CMS Headless / API Spring/Laravel)
# quando `false` (default) o app lê dos repositórios estáticos in-memory
NUXT_PUBLIC_USE_HTTP_REPOSITORIES="false"

# Base URL da API de conteúdo (opcional — usada quando USE_HTTP_REPOSITORIES=true)
NUXT_PUBLIC_API_BASE_URL="https://api.seu-dominio.com"
