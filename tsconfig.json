{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"],
      "~/*": ["./*"],
      "@core/*": ["./core/*"]
    }
  },
  "include": [
    "core/**/*.ts",
    "components/**/*.vue",
    "pages/**/*.vue",
    "layouts/**/*.vue",
    "composables/**/*.ts",
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "app.vue",
    "nuxt.config.ts"
  ]
}
